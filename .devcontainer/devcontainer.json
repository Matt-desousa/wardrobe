{
  "name": "wardrobe",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "web (vite)", "onAutoForward": "notify" }
  },
  "postCreateCommand": "pip install --extra-index-url https://download.pytorch.org/whl/cpu -r ml/requirements.txt && cd web && npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "dbaeumer.vscode-eslint"]
    }
  }
}
